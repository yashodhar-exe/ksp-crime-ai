# --- Database (must match docker-compose.yml's db service port mapping) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ksp_crime

# --- Auth ---
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- AI / RAG (optional — nlp_service.py has a working non-LLM fallback
#     if these are left blank, see backend/app/services/nlp_service.py) ---
OPENAI_OR_LLM_API_KEY=
VECTOR_DB_URL=

# --- CORS: must include whichever origin the frontend actually runs on.
#     Vite's dev server defaults to 5173, not 3000. ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frontend (frontend/.env.example has its own copy of this) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
