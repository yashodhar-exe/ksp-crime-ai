# Consumed by Vite at BUILD time (npm run build), not at runtime — a static
# site has no server to read env vars from later.
#
# This is intentionally a relative path, not the cross-origin backend URL.
# Browser calls to /api/* stay same-origin (served by this app's own
# server.js, which proxies them to the backend server-side). See server.js
# for why: Catalyst's edge answers cross-origin preflights itself and
# drops CORS headers before the backend ever sees the request.
VITE_API_BASE_URL=/api/v1
